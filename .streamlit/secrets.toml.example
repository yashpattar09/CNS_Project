# -----------------------------------------------------------------------------
# OPTIONAL — Supabase Storage backend.
#
# Copy this file to  .streamlit/secrets.toml  for a local run, OR paste the
# [supabase] block into the "Secrets" box of your Streamlit Community Cloud app.
#
# If you leave this OUT entirely, the app falls back to an OFFLINE local vault
# (a ./vault_data folder), which is perfect for the demo/viva and needs no setup.
#
# The `key` below must be the Supabase SERVICE-ROLE key. It stays server-side in
# Streamlit secrets and is NEVER sent to the browser. Confidentiality does not
# depend on it anyway — every stored blob is already AES-encrypted and every
# private key is passphrase-wrapped — but treat the key itself as a secret.
# -----------------------------------------------------------------------------

[supabase]
url    = "https://YOUR-PROJECT-REF.supabase.co"
key    = "YOUR-SUPABASE-SERVICE-ROLE-KEY"
bucket = "ehr-documents"
